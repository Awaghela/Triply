DATABASE_URL=postgres://triply:triply@localhost:5432/triply
JWT_SECRET=change-this-to-a-long-random-string
ACTIVITY_HMAC_SECRET=change-this-to-a-different-long-random-string
BIND_ADDR=0.0.0.0:8080

# Receipt photo storage. Leave AWS_S3_BUCKET empty and receipts are stored
# on local disk instead (see LOCAL_UPLOADS_DIR/PUBLIC_BASE_URL below) --
# a dev/testing stub, not for production use. Set all three AWS_* values to
# use real S3.
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only used when AWS_S3_BUCKET is empty.
LOCAL_UPLOADS_DIR=./uploads
# PUBLIC_BASE_URL is normally NOT needed: the server derives its own
# public URL from each request's Host header (and X-Forwarded-Proto, set
# by most reverse proxies), so local-mode receipt URLs are correct
# automatically in Docker, Railway, behind any proxy, etc. This is only a
# fallback for the rare case a request arrives with no Host header.
PUBLIC_BASE_URL=http://localhost:8080
